{
  "name": "wasteland-behemoths",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/engine.test.ts",
    "bench": "vitest run tests/engine.test.ts -t bench --silent=false",
    "e2e": "playwright test",
    "gates": "npm run typecheck && npm test && npm run e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
